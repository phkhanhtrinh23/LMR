# OpenRouter is the only LLM provider used by this project.
OPENROUTER_API_KEY=
# Model used for shopping agents / generator / validator unless overridden per role below.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional per-role overrides (comma-separated lists allowed for agents).
# Paper §6.1 / App. B.1 choices (OpenRouter IDs checked 2026-10-23):
# GPA scoring agents (A in Eq. 5): open-weight Llama 3.3 70B and Mistral Small 3.2; disjoint from evaluation agents.
OPENROUTER_SCORING_MODELS=meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-3.2-24b-instruct
# Evaluation agents (RQ1): GPT-5, Gemini 2.5 Pro, Qwen3-235B-A22B (2507 instruct is the available Qwen3-235B-A22B).
OPENROUTER_EVAL_MODELS=openai/gpt-5,google/gemini-2.5-pro,qwen/qwen3-235b-a22b-2507
# Candidate generator (Gemma 3 27B, temperature 0.7); the same model judges UNSURE spans.
OPENROUTER_GENERATOR_MODEL=google/gemma-3-27b-it
OPENROUTER_VALIDATOR_MODEL=google/gemma-3-27b-it
